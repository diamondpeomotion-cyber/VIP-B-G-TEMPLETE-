# GEMINI_API_KEY: Required for the Gemini AI style consultant & marketing
# generator. Without it, both features fall back to curated local responses.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_BASE_URL: where this app is hosted. Used to display each
# salon's live URL (e.g. https://yourdomain.com → yourdomain.com/s/yourname
# and yourname.yourdomain.com when wildcard DNS is configured).
APP_URL="MY_APP_URL"
# PUBLIC_BASE_URL="https://yourdomain.com"

# DATABASE_PATH: SQLite database file (owner accounts, salons, services,
# staff, bookings). Point at a persistent volume in production.
# DATABASE_PATH="./data/salonos.db"

# PORT: server port (defaults to 3000)
# PORT=3000
